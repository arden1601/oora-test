# Copy to .env for local overrides. Never commit .env.
# Every value here is a placeholder for local development with fake data.

# PostgreSQL (docker compose)
POSTGRES_USER=portal
POSTGRES_PASSWORD=local-dev-only
POSTGRES_DB=portal

# Ports on your machine (docker compose). Change them if they are already in use.
BACKEND_HOST_PORT=8080
DB_HOST_PORT=5433

# Backend, when run outside Docker with `go run ./cmd/server`
PORT=8080
DATABASE_URL=postgres://portal:local-dev-only@localhost:5433/portal?sslmode=disable
# Set to true wherever the site is served over HTTPS, so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# AI assistant (DeepSeek native API). Leave the key empty to disable the assistant.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
